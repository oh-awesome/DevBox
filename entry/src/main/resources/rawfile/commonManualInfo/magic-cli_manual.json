[
  {
    "name": "magic-cli",
    "description": "基于 Cangjie Agent DSL 和 Cangjie Magic 构建的 AI 命令行助手，支持智能对话、代码生成、文档检索等功能。",
    "syntax": "cli [--auto] [--language <lang>] [--model <model>] [--fast-model <model>] [--fallback-models <models>] [--collect-data] [--sandbox] [--temperature <value>] [--prompt <prompt>] [--prompt-file <file>] [--output-format <format>] [--log-level <level>] [--subagent-dir <dir>] [--command-dir <dir>] [--default-model-input-limit <limit>] [--default-model-output-limit <limit>] [--disable-model-tool-call] [--enable-lsp-tool] [--version] [--help]",
    "options": [
      {
        "paramName": "--auto",
        "description": "启用自动模式，Agent 自主运行，无需用户授权即可执行工具命令。"
      },
      {
        "paramName": "--language, -l",
        "description": "指定生成代码的语言，可选值：[Cangjie, General(Default)]。默认生成通用语言代码，如需生成 Cangjie 代码需特别指定。"
      },
      {
        "paramName": "--model <model>",
        "description": "设置聊天模型，用于主对话任务。"
      },
      {
        "paramName": "--fast-model <model>",
        "description": "设置快速模型，同时启用混合模式（使用快速模型处理辅助任务）。"
      },
      {
        "paramName": "--fallback-models <models>",
        "description": "设置备用模型列表（逗号分隔），当主模型失败时自动切换。"
      },
      {
        "paramName": "--collect-data",
        "description": "启用数据收集功能，用于遥测和分析。"
      },
      {
        "paramName": "--sandbox",
        "description": "启用沙箱模式（默认：false）。"
      },
      {
        "paramName": "--temperature, -t",
        "description": "设置模型的温度参数，控制输出的随机性（默认：1.0）。"
      },
      {
        "paramName": "--prompt <prompt>, -p <prompt>",
        "description": "设置提示词并以非交互模式运行 magic-cli。"
      },
      {
        "paramName": "--prompt-file <file>",
        "description": "从文件读取提示词并以非交互模式运行 magic-cli。"
      },
      {
        "paramName": "--output-format <format>",
        "description": "设置非交互模式的输出格式：plain | colorful（默认：colorful）。"
      },
      {
        "paramName": "--log-level <level>",
        "description": "设置日志级别（默认：DEBUG）。"
      },
      {
        "paramName": "--subagent-dir <dir>",
        "description": "添加 SubAgent 搜索目录（逗号分隔）。"
      },
      {
        "paramName": "--command-dir <dir>",
        "description": "添加命令搜索目录（逗号分隔）。"
      },
      {
        "paramName": "--default-model-input-limit <limit>",
        "description": "设置模型的默认输入 token 限制（默认：128 * 1024）。"
      },
      {
        "paramName": "--default-model-output-limit <limit>",
        "description": "设置模型的默认输出 token 限制（默认：32 * 1024）。"
      },
      {
        "paramName": "--disable-model-tool-call",
        "description": "禁用模型工具调用功能（默认：false）。"
      },
      {
        "paramName": "--enable-lsp-tool",
        "description": "启用 LSP 工具（默认：false）。"
      },
      {
        "paramName": "--version, -v",
        "description": "打印 magic-cli 的版本信息。"
      },
      {
        "paramName": "--help, -h",
        "description": "打印帮助信息。"
      }
    ],
    "examples": [
      "cli",
      "cli --auto",
      "cli --language cangjie",
      "cli --model ark:kimi-k2-250711",
      "cli --prompt \"帮我创建一个 Cangjie 项目\"",
      "cli --prompt-file prompt.txt",
      "cli --auto --language cangjie",
      "cli --help"
    ],
    "showDetails": false
  }
]
