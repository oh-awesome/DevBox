  {
    "name": "gawkbug",
    "description": "用于向 Gawk 维护者发送邮件报告 bug 的工具。",
    "syntax": "gawkbug [--help] [--version] [bug-report-email-address]",
    "options": [
      { "paramName": "--help", "description": "显示帮助信息" },
      { "paramName": "--version", "description": "显示版本信息" }
    ],
    "examples": [
      "gawkbug",
      "gawkbug --help",
      "gawkbug --version",
      "gawkbug custom@email.com"
    ],
    "showDetails": false
  }
]
