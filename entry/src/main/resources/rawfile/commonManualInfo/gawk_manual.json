[
  {
    "name": "gawk",
    "description": "模式扫描和处理语言，用于文本处理和数据提取。",
    "syntax": "gawk [POSIX or GNU style options] -f progfile [--] file ...",
    "options": [
      { "paramName": "-f progfile", "description": "--file=progfile" },
      { "paramName": "-F fs", "description": "--field-separator=fs" },
      { "paramName": "-v var=val", "description": "--assign=var=val" },
      { "paramName": "-b", "description": "--characters-as-bytes" },
      { "paramName": "-c", "description": "--traditional" },
      { "paramName": "-C", "description": "--copyright" },
      { "paramName": "-d[file]", "description": "--dump-variables[=file]" },
      { "paramName": "-D[file]", "description": "--debug[=file]" },
      { "paramName": "-e 'program-text'", "description": "--source='program-text'" },
      { "paramName": "-E file", "description": "--exec=file" },
      { "paramName": "-g", "description": "--gen-pot" },
      { "paramName": "-h", "description": "--help" },
      { "paramName": "-i includefile", "description": "--include=includefile" },
      { "paramName": "-I", "description": "--trace" },
      { "paramName": "-k", "description": "--csv" },
      { "paramName": "-l library", "description": "--load=library" },
      { "paramName": "-L[fatal|invalid|no-ext]", "description": "--lint[=fatal|invalid|no-ext]" },
      { "paramName": "-M", "description": "--bignum" },
      { "paramName": "-N", "description": "--use-lc-numeric" },
      { "paramName": "-n", "description": "--non-decimal-data" },
      { "paramName": "-o[file]", "description": "--pretty-print[=file]" },
      { "paramName": "-O", "description": "--optimize" },
      { "paramName": "-p[file]", "description": "--profile[=file]" },
      { "paramName": "-P", "description": "--posix" },
      { "paramName": "-r", "description": "--re-interval" },
      { "paramName": "-s", "description": "--no-optimize" },
      { "paramName": "-S", "description": "--sandbox" },
      { "paramName": "-t", "description": "--lint-old" },
      { "paramName": "-V", "description": "--version" }
    ],
    "examples": [
      "gawk '{ sum += $1 }; END { print sum }' file",
      "gawk -F: '{ print $1 }' /etc/passwd",
      "gawk -f script.awk input.txt",
      "gawk -v var=value '{ print var, $0 }' file",
      "gawk '/pattern/ { print }' file"
    ],
    "showDetails": false
  },
